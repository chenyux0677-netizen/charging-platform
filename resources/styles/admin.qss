/* ============================================================
 * admin.qss —— 管理员端(桌面风格 1200x800)
 * 强调色:专业蓝 #4a6cf7
 * ============================================================ */

/* 整体浅灰底 */
AdminMainWindow {
    background: #f1f4f9;
}

/* ---------- 顶部标签页 ---------- */
QTabWidget::pane {
    border: none;
    background: #f1f4f9;
    top: -1px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #64748b;
    font-size: 15px;
    padding: 12px 22px;
    margin-right: 6px;
    border: none;
    border-bottom: 3px solid transparent;
}
QTabBar::tab:selected {
    color: #4a6cf7;
    font-weight: 700;
    border-bottom: 3px solid #4a6cf7;
}
QTabBar::tab:hover:!selected {
    color: #334155;
}

/* ---------- 各页标题(左侧色条) ---------- */
AdminMainWindow #pageTitleLabel {
    font-size: 21px;
    font-weight: 700;
    color: #1f2a44;
    border-left: 4px solid #4a6cf7;
    padding-left: 10px;
}

/* ---------- 工具栏的小按钮/组合框留白 ---------- */
AdminMainWindow QComboBox {
    min-width: 90px;
}
AdminMainWindow #phoneSearchEdit {
    min-width: 220px;
}

/* ---------- 电桩状态汇总 ---------- */
#pileSummaryTotal, #pileSummaryFree, #pileSummaryBusy, #pileSummaryFault {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 10px;
}
#pileStatusSummaryCaption {
    color: #7a8698;
    font-size: 12px;
}
#pileTotalValue, #pileFreeValue, #pileBusyValue, #pileFaultValue {
    font-size: 20px;
    font-weight: 700;
}
#pileTotalValue { color: #334155; }
#pileFreeValue { color: #087f5b; }
#pileBusyValue { color: #b45309; }
#pileFaultValue { color: #c24146; }

/* ---------- 管理操作按钮 ---------- */
AdminMainWindow QPushButton {
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    font-weight: 600;
}
AdminMainWindow QPushButton:hover {
    background: #eef2f7;
    border-color: #94a3b8;
}
AdminMainWindow QPushButton:pressed {
    background: #e2e8f0;
}
AdminMainWindow QPushButton:disabled {
    background: #f1f4f8;
    color: #9aa5b4;
    border-color: #dfe5ec;
}

AdminMainWindow #adminAddButton {
    background: #4a6cf7;
    color: #ffffff;
    border-color: #4a6cf7;
}
AdminMainWindow #adminAddButton:hover {
    background: #3b5ce0;
    border-color: #3b5ce0;
}
AdminMainWindow #adminAddButton:pressed {
    background: #3350c6;
    border-color: #3350c6;
}

AdminMainWindow #adminEditButton {
    background: #edf2ff;
    color: #3151c6;
    border-color: #afbef5;
}
AdminMainWindow #adminEditButton:hover {
    background: #dfe7ff;
    border-color: #7890eb;
}

AdminMainWindow #adminDetailsButton {
    background: #f0f9ff;
    color: #0369a1;
    border-color: #7dd3fc;
}
AdminMainWindow #adminDetailsButton:hover {
    background: #e0f2fe;
    border-color: #38bdf8;
}

#stationPileDetailsTitle {
    color: #1f2a44;
    font-size: 17px;
    font-weight: 700;
}

AdminMainWindow #adminRestartButton {
    background: #eef2ff;
    color: #4338ca;
    border-color: #a5b4fc;
}
AdminMainWindow #adminRestartButton:hover {
    background: #e0e7ff;
    border-color: #818cf8;
}

AdminMainWindow #adminDeleteButton,
AdminMainWindow #adminDangerButton {
    background: #fff5f5;
    color: #c53d43;
    border-color: #f1aeb1;
}
AdminMainWindow #adminDeleteButton:hover,
AdminMainWindow #adminDangerButton:hover {
    background: #ffe7e8;
    border-color: #e8787d;
}
AdminMainWindow #adminDeleteButton:pressed,
AdminMainWindow #adminDangerButton:pressed {
    background: #ffd8da;
}

AdminMainWindow #adminPositiveButton {
    background: #e6f7ef;
    color: #087f5b;
    border-color: #91d4b8;
}
AdminMainWindow #adminPositiveButton:hover {
    background: #d5f1e5;
    border-color: #5cbd97;
}

AdminMainWindow #adminAddButton:disabled,
AdminMainWindow #adminEditButton:disabled,
AdminMainWindow #adminRestartButton:disabled,
AdminMainWindow #adminDeleteButton:disabled,
AdminMainWindow #adminDangerButton:disabled,
AdminMainWindow #adminPositiveButton:disabled {
    background: #f1f4f8;
    color: #9aa5b4;
    border-color: #dfe5ec;
}

/* ---------- 销售统计页 ---------- */
#summaryCard {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 12px;
}
#summaryCaptionLabel {
    color: #7a8698;
    font-size: 12px;
}
#summaryValueLabel {
    color: #2a3550;
    font-size: 22px;
    font-weight: 700;
}
SalesPage QChartView {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 10px;
}
SalesPage #placeholderLabel {
    color: #7a8698;
    font-size: 15px;
}
