/* ============================================================
 * user.qss —— 用户端(手机风格 360x640)
 * 强调色:充电绿 #00b26a
 * ============================================================ */

/* 整体浅灰底 + 顶部品牌绿条 */
UserMainWindow {
    background: #eef2f6;
}
UserMainWindow #titleLabel {
    background: #00b26a;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 11px 0;
}

/* 页面标题 */
UserMainWindow #pageTitleLabel {
    font-size: 17px;
    font-weight: 700;
    color: #1f2a44;
    padding: 4px 0 2px;
}

/* ---------- 底部导航条(选中顶边亮绿) ---------- */
#navStationBtn, #navChargeBtn, #navOrderBtn, #navProfileBtn {
    background: transparent;
    border: none;
    border-top: 2px solid transparent;
    color: #7c8a9a;
    font-size: 13px;
    padding: 8px 0 6px;
    border-radius: 0;
}
#navStationBtn:hover, #navChargeBtn:hover,
#navOrderBtn:hover, #navProfileBtn:hover {
    background: #e3e9f0;
    color: #334155;
}
#navStationBtn:checked, #navChargeBtn:checked,
#navOrderBtn:checked, #navProfileBtn:checked {
    background: transparent;
    color: #00b26a;
    font-weight: 700;
    border-top: 2px solid #00b26a;
}

/* ---------- 列表做成白卡片 ---------- */
#stationList, #orderList, #pileList {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 4px;
}
#stationList::item, #orderList::item, #pileList::item {
    border-bottom: 1px solid #f0f3f7;
    border-radius: 8px;
    padding: 12px 10px;
}
#stationList::item:selected, #orderList::item:selected, #pileList::item:selected {
    background: #e6f8f0;
}

/* 电站卡片 */
#stationCardName, #pileCardCode {
    color: #1f2a44;
    font-size: 15px;
    font-weight: 700;
}
#stationDistanceLabel {
    color: #087f5b;
    background: #dff7ec;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 11px;
}
#stationCardAddress, #pileSpecLabel {
    color: #718096;
    font-size: 12px;
}
#stationAvailableLabel {
    color: #087f5b;
    font-size: 12px;
    font-weight: 600;
}
#stationUnavailableLabel {
    color: #94a3b8;
    font-size: 12px;
}
#stationPriceLabel, #pileCardPrice {
    color: #1f2a44;
    font-size: 13px;
    font-weight: 700;
}

/* 电桩可用状态 */
#pileStatusFree, #pileStatusBusy, #pileStatusFault {
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}
#pileStatusFree {
    color: #087f5b;
    background: #dff7ec;
}
#pileStatusBusy {
    color: #b45309;
    background: #fff1cc;
}
#pileStatusFault {
    color: #c24146;
    background: #ffe4e6;
}

/* 订单卡片：窄屏分行展示，金额固定在右侧，不使用横向长文本。 */
#orderNumberLabel {
    color: #1f2a44;
    font-size: 14px;
    font-weight: 700;
}
#orderMetaLabel, #orderUsageLabel {
    color: #718096;
    font-size: 12px;
}
#orderCardAmountLabel {
    color: #1f2a44;
    font-size: 15px;
    font-weight: 700;
}
#orderStatusCharging, #orderStatusPending, #orderStatusCompleted {
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}
#orderStatusCharging {
    color: #087f5b;
    background: #dff7ec;
}
#orderStatusPending {
    color: #b45309;
    background: #fff1cc;
}
#orderStatusCompleted {
    color: #64748b;
    background: #edf1f5;
}

/* ---------- 电站详情页 ---------- */
#backButton {
    background: transparent;
    color: #00b26a;
    border: none;
    font-size: 14px;
    padding: 2px 4px;
    text-align: left;
}
#backButton:hover {
    background: #dff4ea;
}
#stationNameLabel {
    font-size: 20px;
    font-weight: 700;
}
#stationAddrLabel {
    color: #7a8698;
    font-size: 12px;
}
#navigationButton {
    background: #00a864;
    color: #ffffff;
    border: 1px solid #008f56;
    font-size: 14px;
    font-weight: 700;
    padding: 9px 0;
}
#navigationButton:hover {
    background: #008f56;
}
#navigationButton:pressed {
    background: #007548;
}
#navigationButton:disabled {
    background: #dfe7e3;
    color: #87958e;
    border-color: #ccd7d1;
}

/* 地图路线方式：未选中项保持清晰边界，选中项使用用户端强调色。 */
#drivingRouteButton, #walkingRouteButton {
    background: #ffffff;
    color: #3f554b;
    border: 1px solid #b8c9c1;
    font-weight: 600;
    padding: 7px 18px;
}
#drivingRouteButton:hover, #walkingRouteButton:hover {
    background: #edf8f3;
    border-color: #75bd9e;
}
#drivingRouteButton:checked, #walkingRouteButton:checked {
    background: #d9f5e9;
    color: #007a49;
    border-color: #55bd91;
    font-weight: 700;
}
#drivingRouteButton:checked:hover, #walkingRouteButton:checked:hover {
    background: #c9eedf;
}

#navigationBackButton {
    background: transparent;
    color: #008f56;
    border: none;
    padding: 2px 4px;
    text-align: left;
}
#navigationBackButton:hover {
    background: #dff4ea;
}

/* ---------- 充电页 ---------- */
#chargePileCard, #chargeProgressCard {
    background: #ffffff;
    border: 1px solid #dfe6ed;
    border-radius: 12px;
}
#chargeStationLabel {
    color: #1f2a44;
    font-size: 16px;
    font-weight: 700;
}
#pileLabel {
    font-size: 13px;
    font-weight: 600;
    color: #526174;
}
#priceLabel {
    color: #087f5b;
    background: #dff7ec;
    border-radius: 8px;
    padding: 3px 7px;
    font-size: 12px;
    font-weight: 700;
}
#chargeProgressCaption {
    color: #7a8698;
    font-size: 12px;
}
#energyLabel, #amountLabel {
    font-size: 13px;
    color: #526174;
    font-weight: 600;
}
#timeLabel {
    font-size: 26px;
    font-weight: 700;
    color: #00b26a;
}
#startChargeBtn {
    background: #00b26a;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 0;
    border-radius: 10px;
}
#startChargeBtn:hover {
    background: #00995c;
}
#startChargeBtn:pressed {
    background: #007e4d;
}
#startChargeBtn:disabled {
    background: #bcdccd;
    color: #eef7f2;
}
#stopChargeBtn {
    background: #ffffff;
    color: #e5484d;
    border: 1px solid #ffc9cb;
    font-size: 16px;
    font-weight: 600;
    padding: 11px 0;
    border-radius: 10px;
}
#stopChargeBtn:hover {
    background: #fff1f2;
}
#stopChargeBtn:disabled {
    background: #f4f6f8;
    color: #c9d1dc;
    border-color: #e9edf3;
}

/* ---------- 订单页结算按钮 ---------- */
#settleBtn {
    background: #00b26a;
    color: #ffffff;
    font-weight: 600;
    padding: 9px 0;
}
#settleBtn:hover {
    background: #00995c;
}
#settleBtn:disabled {
    background: #c6e0d4;
    color: #f0f9f4;
}

/* ---------- 我的页 ---------- */
#avatarBtn {
    background: #00b26a;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    border: none;
    border-radius: 36px;
    padding: 0;
}
#avatarBtn:hover {
    background: #00995c;
}
#nicknameLabel {
    font-size: 17px;
    font-weight: 700;
}
#balanceLabel {
    font-size: 15px;
    color: #334155;
}
#rechargeBtn {
    background: #ffffff;
    color: #00b26a;
    border: 1px solid #bfe6d5;
    font-weight: 600;
    padding: 10px 0;
    border-radius: 10px;
}
#rechargeBtn:hover {
    background: #eafaf3;
}
#changeNicknameBtn {
    background: #ffffff;
    color: #334155;
    border: 1px solid #dde4ec;
    padding: 10px 0;
    border-radius: 10px;
}
#changeNicknameBtn:hover {
    background: #f4f7fa;
}
#logoutBtn {
    background: transparent;
    color: #e5484d;
    font-size: 13px;
    padding: 6px 0;
}
#logoutBtn:hover {
    color: #c93a3f;
    background: transparent;
}
